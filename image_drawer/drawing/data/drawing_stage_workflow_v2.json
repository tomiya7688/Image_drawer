{
  "schema_version": "idraw-stage-workflow/v2",
  "workflow_id": "illustration-standard-v2",
  "description": "工程は必ずラフ→下書き→本描き→基本色→陰影・仕上げ→修正・確認→完成。工程のスキップは不可。筆跡や道具はAIが画像を見本に試行学習する。人間の筆跡データは不要。",
  "stages": [
    {
      "id": "rough",
      "name_ja": "ラフ",
      "purpose": "配置・シルエット・全体バランスを大まかに描く",
      "required": true,
      "layer_roles": [
        "rough"
      ],
      "write_layer_roles": [
        "rough"
      ],
      "min_effectful_strokes": 1,
      "review_only_reason_codes": [],
      "suggested_brush_families": [
        "sketch",
        "ink"
      ]
    },
    {
      "id": "sketch",
      "name_ja": "下書き",
      "purpose": "大まかな形を具体化し、比率・構造・位置を整える",
      "required": true,
      "layer_roles": [
        "sketch"
      ],
      "write_layer_roles": [
        "sketch"
      ],
      "min_effectful_strokes": 1,
      "review_only_reason_codes": [],
      "suggested_brush_families": [
        "sketch",
        "ink"
      ]
    },
    {
      "id": "final_drawing",
      "name_ja": "本描き",
      "purpose": "清書する。輪郭線に限らず厚塗りの本番の形・面も許す",
      "required": true,
      "layer_roles": [
        "final_drawing"
      ],
      "write_layer_roles": [
        "final_drawing"
      ],
      "min_effectful_strokes": 1,
      "review_only_reason_codes": [],
      "suggested_brush_families": [
        "ink",
        "paint"
      ]
    },
    {
      "id": "base_color",
      "name_ja": "基本色",
      "purpose": "主要色・広い色面を描く。モノクロの線画作品ならレビューのみ可",
      "required": true,
      "layer_roles": [
        "base_color"
      ],
      "write_layer_roles": [
        "base_color"
      ],
      "min_effectful_strokes": 1,
      "review_only_reason_codes": [
        "monochrome_line_art_only"
      ],
      "suggested_brush_families": [
        "color",
        "paint"
      ]
    },
    {
      "id": "shading",
      "name_ja": "陰影・仕上げ",
      "purpose": "影・光・質感・ハイライトを描く。陰影不要のフラットな画風ならレビューのみ可",
      "required": true,
      "layer_roles": [
        "shade",
        "highlight"
      ],
      "write_layer_roles": [
        "shade",
        "highlight"
      ],
      "min_effectful_strokes": 1,
      "review_only_reason_codes": [
        "flat_style_no_shading"
      ],
      "suggested_brush_families": [
        "shade",
        "paint",
        "texture"
      ]
    },
    {
      "id": "refine",
      "name_ja": "修正・確認",
      "purpose": "必要な箇所を直し、修正不要ならレビューして完成を承認する",
      "required": true,
      "layer_roles": [
        "correction"
      ],
      "write_layer_roles": [
        "base_color",
        "shade",
        "final_drawing",
        "highlight",
        "correction"
      ],
      "min_effectful_strokes": 0,
      "review_only_reason_codes": [
        "no_correction_needed"
      ],
      "suggested_brush_families": [
        "ink",
        "paint",
        "erase"
      ]
    }
  ],
  "terminal": "finish",
  "initial_stage": "rough",
  "stage_change_action": "advance_stage",
  "stage_change_payload": "{} unless review_only; review_only uses {review_reason:<allowed-code>}",
  "stage_action_source": "drawing-policy-model-proposal-checked-by-controller",
  "forbidden_action_types": [
    "skip_stage",
    "set_phase",
    "direct_pixel_write",
    "copy_target_image"
  ],
  "allowed_model_actions": [
    "create_layer",
    "select_layer",
    "select_brush",
    "set_brush_params",
    "select_color",
    "stroke_v2",
    "erase_v2",
    "advance_stage"
  ],
  "controller_only_actions": [
    "enter_stage",
    "exit_stage",
    "set_layer_visibility",
    "clear_active_layer",
    "finish"
  ],
  "require_stage_entry_and_exit": true,
  "allow_skip_stage": false,
  "forbid_backwards_transition": true,
  "forbid_stage_reordering": true,
  "allow_editing_prior_layers_only_in_refine": true,
  "layer_z_order_bottom_to_top": [
    "rough",
    "sketch",
    "base_color",
    "shade",
    "final_drawing",
    "highlight",
    "correction"
  ],
  "layer_visibility_transitions": [
    {
      "on_enter_stage": "final_drawing",
      "hide_layer_roles": [
        "rough"
      ]
    },
    {
      "on_enter_stage": "base_color",
      "hide_layer_roles": [
        "sketch"
      ]
    }
  ],
  "no_op_review_requires_evaluator_justification": true,
  "stage_ready_rule": "At least min_effectful_strokes changes on eligible stage layer(s), except explicit reviewed no-op with allowed reason code. All stages are entered/exited; review-only is not a skip.",
  "mandatory_stage_stroke_actions": [
    "stroke_v2"
  ],
  "terminal_after": "refine",
  "renderer_kind": "sequential-actions",
  "workflow_is_not_human_traces": true,
  "target_image_policy": "evaluator_only_never_policy_observation",
  "legacy_v1_phase_mode": "legacy golden replay only",
  "transition_acceptance": {
    "proposal_action": "advance_stage",
    "proposal_payload_variants": [
      "{}",
      "{\"review_reason\":\"<current-stage-allowed-code>\"}"
    ],
    "target_selection": "next-stage-only; model must not supply destination",
    "event_commit_order": [
      "advance_stage",
      "exit_stage",
      "set_layer_visibility(if needed)",
      "enter_stage(next stage)",
      "create_layer(if entry role needed)",
      "clear_active_layer"
    ],
    "final_stage_commit_order": [
      "advance_stage",
      "exit_stage",
      "finish"
    ],
    "atomic_stage_boundary": true,
    "controller_event_actor": "system",
    "model_proposal_actor": "model",
    "rejected_proposal_has_no_event_seq": true,
    "rejected_proposal_is_logged_as_trial": true
  },
  "effectful_stroke_definition": "accepted stroke_v2 that alters at least one pixel on eligible layer and leaves visible alpha>0 on required rough/sketch/final_drawing layer upon exit; erase/select only cannot satisfy mandatory drawing",
  "stage_exit_approval": {
    "initial_three": ">=1 effectful stroke_v2 on own dedicated layer and nontransparent paint remaining at exit",
    "normal_color_or_shading": ">=1 effectful stroke_v2 on currently allowed layer",
    "normal_refine": ">=1 accepted effectful stroke_v2 or erase_v2 on allowed visible layer",
    "review_only": "no stage draw/erase actions, allowed review_reason; independent non-target prompt/state condition check",
    "inapplicable_review": "reject with auditable reason; do not auto insert strokes or advance"
  },
  "resource_policy": {
    "source": "DRAW_EPISODE.max_actions",
    "proposal_budget_source": "DRAW_EPISODE.max_actions (explicit or default)",
    "count_accepted_model_actions": true,
    "count_rejected_proposals_in_separate_attempt_budget": true,
    "count_controller_events_separately": true,
    "exhaustion": "incomplete Draft with failure; no auto-finish, no implicit stage jump",
    "no_stage_soft_quota_as_legal_action_mask": true,
    "attempt_limit_formula": "max(100, 5 * max_actions)",
    "max_actions_default_current_workflow": 1000,
    "max_actions_hard_limit_current_workflow": 100000,
    "attempts_include_rejected_and_accepted": true,
    "no_auto_stage_advance_on_exhaustion": true
  },
  "policy_observation_excludes": [
    "target_image",
    "target_features",
    "target_dependent_reward",
    "future_accepted_actions",
    "future_stage_result"
  ],
  "stage_layer_creation_rule": "The controller creates a transparent role layer on entering each stage requiring a new role; action create_layer(role) can create more allowed-role layers; initial layer order is not final z order",
  "layer_blend_profile": "normal-rgba, fixed z order independent of creation order; precise pixel compositing is a separate Renderer v2 contract",
  "stage_entry_default_layer_roles": {
    "rough": "rough",
    "sketch": "sketch",
    "final_drawing": "final_drawing",
    "base_color": "base_color",
    "shading": "shade",
    "refine": null
  },
  "state_entry_reset": {
    "active_layer_id": null,
    "selected_brush_id": "preserve",
    "selected_color_id": "preserve",
    "brush_size_and_opacity": "preserve"
  },
  "review_only_guard": {
    "base_color": "StyleIntent.monochrome_line_art_only == true, inferred solely from prompt; unknown=false",
    "shading": "StyleIntent.flat_style_no_shading == true, inferred solely from prompt; unknown=false",
    "refine": "Policy asserts no_correction_needed; stage is exited but final quality is separately evaluated",
    "target_image_forbidden": true,
    "no_prior_effectful_stroke_or_erase_in_current_stage": true,
    "unknown_intent_policy": "reject"
  }
}
