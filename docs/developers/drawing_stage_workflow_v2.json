{
  "schema_version": "idraw-stage-workflow/v2",
  "workflow_id": "illustration-standard-v2",
  "description": "作品の描き方自体はAIが試行学習する。制作工程だけはラフ→下書き→本描き→ベース色→陰影→仕上げ→完成の固定順序とする。人間の筆跡は不要。",
  "stages": [
    {
      "id": "rough",
      "name_ja": "ラフ",
      "purpose": "全体の配置・大まかな形を描く",
      "required": true,
      "min_strokes": 1,
      "dedicated_layer": true
    },
    {
      "id": "sketch",
      "name_ja": "下書き",
      "purpose": "形状・比率・構造を具体化する",
      "required": true,
      "min_strokes": 1,
      "dedicated_layer": true
    },
    {
      "id": "final_drawing",
      "name_ja": "本描き",
      "purpose": "本番の形・線・面を描き上げる。必ずしも黒い線画に限らない",
      "required": true,
      "min_strokes": 1,
      "dedicated_layer": true
    },
    {
      "id": "base_color",
      "name_ja": "基本色",
      "purpose": "作品に必要な色や大きな明暗面を置く",
      "required": false,
      "min_strokes": 1,
      "dedicated_layer": true,
      "skip_reason_codes": [
        "no_color_required"
      ]
    },
    {
      "id": "shading",
      "name_ja": "陰影・質感",
      "purpose": "影・光・材質感を描く",
      "required": false,
      "min_strokes": 1,
      "dedicated_layer": true,
      "skip_reason_codes": [
        "flat_style_requested"
      ]
    },
    {
      "id": "refine",
      "name_ja": "仕上げ・修正",
      "purpose": "小さな描き込みや消去・修正を行う",
      "required": true,
      "min_strokes": 1,
      "dedicated_layer": false
    }
  ],
  "terminal": "finish",
  "stage_change_action": "advance_stage",
  "skip_action": "skip_stage",
  "initial_stage": "rough",
  "action_stage_source": "episode-v2-state",
  "mandatory_stage_stroke_actions": [
    "stroke_v2"
  ],
  "optional_stage_skip_constraints": "skip only if the condition is justified by prompt; evaluator checks and logs misuse",
  "forbid_backwards_transition": true,
  "forbid_stage_reordering": true,
  "allow_editing_prior_layers_without_stage_reentry": true,
  "workflow_is_not_human_traces": true,
  "renderer_kind": "sequential-actions",
  "legacy_v1_phase_mode": "legacy golden replay only"
}
