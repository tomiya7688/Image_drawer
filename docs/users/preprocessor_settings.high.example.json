{
  "schema_version": "idraw-preprocessor-registry/v1",
  "description_ja": "高設定: 8B VLM 3モデルを主に使う比較・研究用。24GB以上のVRAMまたは十分なCPUオフロード環境が必要で、既定の8GBプロファイルではない。外部Taggerサービスの設定も必要。",
  "providers": [
    {
      "id": "accurate-vlm",
      "kind": "caption",
      "adapter": "openai_compatible",
      "model_id": "Qwen/Qwen3-VL-8B-Instruct",
      "endpoint": "http://127.0.0.1:8000/v1/chat/completions",
      "json_mode": true
    },
    {
      "id": "joycaption-fallback",
      "kind": "caption",
      "adapter": "joycaption",
      "model_id": "fancyfeast/llama-joycaption-beta-one-hf-llava",
      "endpoint": "http://127.0.0.1:8001/v1/chat/completions",
      "json_mode": false
    },
    {
      "id": "nsfw-caption-last",
      "kind": "caption",
      "adapter": "prose_caption",
      "model_id": "Felldude/Qwen3-VL-8B-Instruct-Uncensored-V2",
      "endpoint": "http://127.0.0.1:8002/v1/chat/completions",
      "json_mode": false
    },
    {
      "id": "content-tagger",
      "kind": "tagger",
      "adapter": "tagger_http",
      "backend": "tagger_service_http",
      "model_id": "REPLACE_WITH_TAGGER_MODEL",
      "endpoint": "http://127.0.0.1:7861/tagger/v1/interrogate",
      "threshold": 0.35
    },
    {
      "id": "backup-tagger",
      "kind": "tagger",
      "adapter": "tagger_http",
      "backend": "pixai_http",
      "model_id": "REPLACE_WITH_PIXAI_TAGGER_MODEL",
      "endpoint": "http://127.0.0.1:7862/pixai/v1/interrogate",
      "threshold": 0.35,
      "character_threshold": 0.85
    }
  ],
  "caption_chain": [
    "accurate-vlm",
    "joycaption-fallback",
    "nsfw-caption-last"
  ],
  "tag_chain": [
    "content-tagger",
    "backup-tagger"
  ],
  "verifier_id": null,
  "tag_normalizer": {
    "min_confidence": 0.35,
    "character_confidence": 0.85,
    "category_overrides": {
      "red_hair": "appearance"
    },
    "extra_categories": [
      "appearance"
    ]
  },
  "tag_formatter": {
    "include_style": false,
    "include_copyright": false,
    "include_rating": false,
    "include_meta": false,
    "exclude_quality_fillers": true
  },
  "text_encoder": {
    "description_ja": "学習時と生成時は同じモデル・改訂・次元に固定する。CUDA OOMなどでGPUモデルをreleaseし同一モデルのCPUへフォールバック。別モデルの特徴空間は自動で混ぜない。",
    "providers": [
      {
        "id": "text-encoder-gpu",
        "adapter": "sentence_transformer",
        "model_id": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
        "model_revision": "main",
        "device": "cuda",
        "dimension": 384
      },
      {
        "id": "text-encoder-cpu-fallback",
        "adapter": "sentence_transformer",
        "model_id": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
        "model_revision": "main",
        "device": "cpu",
        "dimension": 384
      }
    ],
    "fallback_policy": "same_model_same_revision_same_dimension_only",
    "release_after_encode": true,
    "note": "本番の再現実験ではmodel_revisionを実際のcommit SHAに固定して学習・推論で共有する"
  }
}
