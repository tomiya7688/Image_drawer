{
  "schema_version": "idraw-preprocessor-registry/v1",
  "description_ja": "通常設定: VRAM 8GB/メインメモリ32GB。llama.cppルーターが必要なVLMだけを読み込み、画像からCaptionとタグを別々に抽出。高設定はpreprocessor_settings.high.example.json。",
  "hardware_profile": {
    "id": "local-8g-32g",
    "target_vram_gb": 8,
    "target_ram_gb": 32,
    "backend": "llama.cpp router (--models-dir、量子化GGUFとmmprojを1組ずつ登録)",
    "max_loaded_models": 1,
    "context_tokens": 4096,
    "parallel_requests": 1,
    "note": "GPUのVRAMを実測していないため8GBで必ず動くとは保証しない。タグは別推論だがQwen/Felldudeの既存モデル重みを共有。",
    "model_dir_setup": "python scripts/setup_local_8g_models.py",
    "model_ids_source": "ローカル配置の各サブディレクトリ名（llama.cpp /modelsで確認する）"
  },
  "providers": [
    {
      "id": "accurate-vlm",
      "kind": "caption",
      "adapter": "openai_compatible",
      "model_id": "qwen3vl4b-q4",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
      "json_mode": true,
      "timeout_seconds": 300,
      "model_revision": "Qwen/Qwen3-VL-4B-Instruct-GGUF:Q4_K_M"
    },
    {
      "id": "joycaption-fallback",
      "kind": "caption",
      "adapter": "joycaption",
      "model_id": "joycaption-beta-one-q3",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
      "json_mode": false,
      "timeout_seconds": 300,
      "model_revision": "mradermacher/Q3_K_M + concedo/mmproj-f16"
    },
    {
      "id": "nsfw-caption-last",
      "kind": "caption",
      "adapter": "prose_caption",
      "model_id": "qwen3vl4b-uncensored-q4",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
      "json_mode": false,
      "timeout_seconds": 300,
      "model_revision": "mradermacher/Qwen3-VL-4B-Instruct-Uncensored-GGUF:Q4_K_M"
    },
    {
      "id": "content-tagger",
      "kind": "tagger",
      "adapter": "vision_tagger",
      "model_id": "qwen3vl4b-q4",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
      "json_mode": true,
      "timeout_seconds": 300,
      "model_revision": "Qwen/Qwen3-VL-4B-Instruct-GGUF:Q4_K_M"
    },
    {
      "id": "backup-tagger",
      "kind": "tagger",
      "adapter": "vision_tagger",
      "model_id": "qwen3vl4b-uncensored-q4",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
      "json_mode": true,
      "timeout_seconds": 300,
      "model_revision": "mradermacher/Qwen3-VL-4B-Instruct-Uncensored-GGUF:Q4_K_M"
    }
  ],
  "caption_chain": [
    "accurate-vlm",
    "joycaption-fallback",
    "nsfw-caption-last"
  ],
  "tag_chain": [
    "content-tagger",
    "backup-tagger"
  ],
  "verifier_id": null,
  "tag_normalizer": {
    "min_confidence": 0.35,
    "character_confidence": 0.85,
    "category_overrides": {
      "red_hair": "appearance"
    },
    "extra_categories": [
      "appearance"
    ]
  },
  "tag_formatter": {
    "include_style": false,
    "include_copyright": false,
    "include_rating": false,
    "include_meta": false,
    "exclude_quality_fillers": true
  },
  "text_encoder": {
    "description_ja": "学習時と生成時は同じモデル・改訂・次元に固定する。CUDA OOMなどでGPUモデルをreleaseし同一モデルのCPUへフォールバック。別モデルの特徴空間は自動で混ぜない。",
    "providers": [
      {
        "id": "text-encoder-gpu",
        "adapter": "sentence_transformer",
        "model_id": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
        "model_revision": "main",
        "device": "cuda",
        "dimension": 384
      },
      {
        "id": "text-encoder-cpu-fallback",
        "adapter": "sentence_transformer",
        "model_id": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
        "model_revision": "main",
        "device": "cpu",
        "dimension": 384
      }
    ],
    "fallback_policy": "same_model_same_revision_same_dimension_only",
    "release_after_encode": true,
    "note": "本番の再現実験ではmodel_revisionを実際のcommit SHAに固定して学習・推論で共有する"
  }
}
