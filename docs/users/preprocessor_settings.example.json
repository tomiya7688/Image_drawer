{
  "schema_version": "idraw-preprocessor-registry/v1",
  "description_ja": "通常設定: VRAM 8GB/メインメモリ32GB。llama.cppルーターが必要なVLMだけを読み込み、画像からCaptionとタグを別々に抽出。高設定はpreprocessor_settings.high.example.json。",
  "hardware_profile": {
    "id": "local-8g-32g",
    "target_vram_gb": 8,
    "target_ram_gb": 32,
    "backend": "llama.cpp router (GGUF, image projector)",
    "max_loaded_models": 1,
    "context_tokens": 4096,
    "parallel_requests": 1,
    "note": "GPUのVRAMを実測していないため8GBで必ず動くとは保証しない。タグは別推論だがQwen/Felldudeの既存モデル重みを共有。"
  },
  "providers": [
    {
      "id": "accurate-vlm",
      "kind": "caption",
      "adapter": "openai_compatible",
      "model_id": "Qwen/Qwen3-VL-4B-Instruct-GGUF:Q4_K_M",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
      "json_mode": true,
      "timeout_seconds": 300
    },
    {
      "id": "joycaption-fallback",
      "kind": "caption",
      "adapter": "joycaption",
      "model_id": "mradermacher/llama-joycaption-beta-one-hf-llava-GGUF:Q3_K_M",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
      "json_mode": false,
      "timeout_seconds": 300
    },
    {
      "id": "nsfw-caption-last",
      "kind": "caption",
      "adapter": "prose_caption",
      "model_id": "mradermacher/Qwen3-VL-4B-Instruct-Uncensored-GGUF:Q4_K_M",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
      "json_mode": false,
      "timeout_seconds": 300
    },
    {
      "id": "content-tagger",
      "kind": "tagger",
      "adapter": "vision_tagger",
      "model_id": "Qwen/Qwen3-VL-4B-Instruct-GGUF:Q4_K_M",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
      "json_mode": true,
      "timeout_seconds": 300
    },
    {
      "id": "backup-tagger",
      "kind": "tagger",
      "adapter": "vision_tagger",
      "model_id": "mradermacher/Qwen3-VL-4B-Instruct-Uncensored-GGUF:Q4_K_M",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
      "json_mode": true,
      "timeout_seconds": 300
    }
  ],
  "caption_chain": [
    "accurate-vlm",
    "joycaption-fallback",
    "nsfw-caption-last"
  ],
  "tag_chain": [
    "content-tagger",
    "backup-tagger"
  ],
  "verifier_id": null,
  "tag_normalizer": {
    "min_confidence": 0.35,
    "character_confidence": 0.85,
    "category_overrides": {
      "red_hair": "appearance"
    },
    "extra_categories": [
      "appearance"
    ]
  },
  "tag_formatter": {
    "include_style": false,
    "include_copyright": false,
    "include_rating": false,
    "include_meta": false,
    "exclude_quality_fillers": true
  }
}
